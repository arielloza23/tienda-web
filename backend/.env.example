APP_NAME="Tienda Web API"
API_V1_PREFIX="/api/v1"
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/tienda_web"
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Solo desarrollo: false deja abiertos los endpoints de admin
AUTH_ENABLED=true
# Lista JSON con los dominios del frontend que pueden llamar a la API
CORS_ORIGINS='["http://localhost:4200"]'

# Recuperacion por correo: dejar sin SMTP_HOST hasta disponer de un proveedor.
# Credenciales solo en el gestor de secretos del backend.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
# SMTP_USER=usuario-del-proveedor
# SMTP_PASSWORD=secreto-del-proveedor
# SMTP_FROM=tienda@example.com
# URL fija de tu frontend (nunca se toma del Host ni del cuerpo de la solicitud).
PASSWORD_RESET_URL="https://arielloza23.github.io/tienda-web/#/reset-password"
